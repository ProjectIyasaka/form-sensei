---
import '../styles/global.css';
import PoseAnalyzer from '../components/PoseAnalyzer';
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>静止画解析 | form-sensei</title>
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100 antialiased">
    <div class="mx-auto max-w-4xl px-4 py-6 sm:px-6 sm:py-8">
      <!-- パンくずナビ -->
      <nav class="mb-6 flex items-center gap-2 text-sm" aria-label="パンくず">
        <a href="/" class="flex min-h-[44px] items-center gap-1.5 rounded-lg px-2 py-1 text-slate-400 transition-colors hover:text-slate-100">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
            <path d="m15 18-6-6 6-6" />
          </svg>
          ホーム
        </a>
        <span class="text-slate-700" aria-hidden="true">/</span>
        <span class="font-medium text-cyan-400">静止画解析</span>
      </nav>

      <!-- ページヘッダー -->
      <div class="mb-6">
        <h1 class="text-2xl font-bold text-slate-100">静止画解析 <span class="ml-2 text-xs font-medium tracking-wider text-slate-500 align-middle">PoC</span></h1>
        <p class="mt-1 text-sm text-slate-400">骨格検出・関節角度の確認</p>
      </div>

      <PoseAnalyzer client:only="react" />
    </div>
  </body>
</html>
